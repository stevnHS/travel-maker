# Neon Postgres 連線字串
NUXT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session 加密金鑰（至少 32 字元）
NUXT_SESSION_PASSWORD=

# LINE Login channel（LINE Developers Console）
NUXT_OAUTH_LINE_CLIENT_ID=
NUXT_OAUTH_LINE_CLIENT_SECRET=
# Callback URL 需同時登錄於 LINE Console，例如 http://localhost:3000/auth/line
NUXT_OAUTH_LINE_REDIRECT_URL=http://localhost:3000/auth/line
